# ---- MediVoc Voice AI Agent ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
WHISPER_MODEL=tiny

# ---- Auth ----
# Any random string. Changing it signs every user out.
MEDIVOC_SECRET=medivoc-dev-secret-change-me

# ---- Email (appointment confirmations & cancellations) ----
# Leave SMTP_HOST empty to run in demo mode: emails are printed and appended
# to backend/data/sent_emails.log instead of being delivered.
# For Gmail use an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
